# ============================================================
# DSA Video Studio - environment configuration
# Copy this file to .env and fill in real values.
# Never commit the real .env file.
# ============================================================

# ---- Database ----
POSTGRES_USER=dsa_studio
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dsa_video_studio
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://dsa_studio:change_me@postgres:5432/dsa_video_studio

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- Auth ----
# Static admin API key. Sent as `X-API-Key` header. Required on all /api/* routes
# except /api/health. Generate a long random value in production.
API_KEY=dev-local-admin-key-change-me

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:3000

# ---- Storage ----
# STORAGE_TYPE: local | s3 | r2 (only "local" is implemented today)
STORAGE_TYPE=local
STORAGE_PATH=/data/storage
PUBLIC_MEDIA_BASE_URL=http://localhost:8000/media

# ---- Rendering ----
RENDER_TIMEOUT_SECONDS=600
MAX_UPLOAD_SIZE_MB=50
MANIM_QUALITY=medium

# ---- Future AI providers (not wired up yet) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- AWS Bedrock: narrative/title generation ----
# Bedrock API key (bearer token, starts "ABSK..."). Bedrock/Bedrock Runtime
# actions only - it cannot call other AWS services (e.g. Polly).
# NEVER commit a real value here - this file only holds placeholders.
BEDROCK_API_KEY=
BEDROCK_REGION=us-west-2
# Region for the Mantle gateway (the path actually used - see config.py's comment on bedrock_mantle_region)
BEDROCK_MANTLE_REGION=us-east-1
BEDROCK_MODEL_ID=deepseek.v3.2

# ---- ElevenLabs: narration TTS (fallback if AWS Polly isn't configured) ----
# NEVER commit a real value here - this file only holds placeholders.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---- Amazon Polly: narration TTS (preferred when set) ----
# Real IAM access key/secret (SigV4) - NOT the Bedrock API key above, which
# cannot call Polly. NEVER commit real values here - placeholders only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
POLLY_REGION=us-east-1
POLLY_VOICE_ID=Ruth
POLLY_ENGINE=generative

# ---- Backend (used by backend container itself) ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ---- Frontend ----
# Public base URL the browser uses (same-origin proxy, so this is just the frontend's own origin)
NEXT_PUBLIC_APP_NAME=DSA Video Studio
# Internal URL the Next.js server (route handlers) uses to reach FastAPI - not exposed to browser
BACKEND_INTERNAL_URL=http://backend:8000
